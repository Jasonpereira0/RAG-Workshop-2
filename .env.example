# ==========================================
# ENVIRONMENT VARIABLES TEMPLATE
# ==========================================
# Copy this file to .env and fill in your actual credentials
# NEVER commit your .env file to version control!

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Neo4j Database Configuration
NEO4J_URI=your_neo4j_database_uri_here
NEO4J_USERNAME=your_neo4j_username_here
NEO4J_PASSWORD=your_neo4j_password_here

# Example Neo4j URI formats:
# For Neo4j AuraDB: neo4j+s://your-instance-id.databases.neo4j.io
# For local Neo4j: bolt://localhost:7687
# For Neo4j Desktop: bolt://localhost:7687

# ==========================================
# SECURITY NOTES:
# ==========================================
# 1. Never commit real credentials to version control
# 2. Use strong, unique passwords
# 3. Rotate credentials regularly
# 4. Use environment-specific credentials
# 5. Consider using secret management services in production
